---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import HomeContent from '../components/HomeContent'
import ProjectCard from '../components/ProjectCard.astro'
import { getProjects } from '../lib/projects'

const featuredProjects = (await getProjects()).filter((p) => p.featured)

const tripReports = (
  await getCollection('blog', ({ data }) => data.published && data.tripReport)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<Layout>
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
    <div class="home-bg-software absolute inset-0"></div>
    <div class="home-bg-outdoors absolute inset-0"></div>
  </div>
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-14 px-4 pb-14 pt-6 md:pt-10">
    <div class="flex justify-center">
      <HomeContent client:load />
    </div>

    <div class="grid gap-10 md:grid-cols-2 md:gap-8">
      <section data-col="software" class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between border-b border-border pb-2">
          <h2 class="text-xl font-bold">What I'm building</h2>
          <a href="/projects" class="text-sm text-primary hover:underline">
            All projects →
          </a>
        </div>
        <div class="flex flex-col gap-4">
          {featuredProjects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section data-col="outdoors" class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between border-b border-border pb-2">
          <h2 class="text-xl font-bold">Recently, outside</h2>
          <a href="/blog" class="text-sm text-primary hover:underline">
            All posts →
          </a>
        </div>
        <div class="flex flex-col gap-4">
          {
            tripReports.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card transition-shadow hover:shadow-lg"
              >
                {post.data.heroImage && (
                  <div class="h-52 overflow-hidden border-b border-border">
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt || ''}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      widths={[400, 600]}
                    />
                  </div>
                )}
                <div class="flex flex-col gap-1 p-4">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-muted"
                  >
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  <h3 class="font-bold transition-colors group-hover:text-primary">
                    {post.data.title}
                  </h3>
                  <p class="line-clamp-2 text-sm text-muted">
                    {post.data.description}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<style is:global>
  /* Hover-reactive columns and background tint, driven by html[data-profile]
     set from HomeContent. Desktop only — mobile is static after the intro. */
  @media (min-width: 768px) {
    .home-bg-software,
    .home-bg-outdoors {
      opacity: 0;
      transition: opacity 1.2s ease;
    }
    .home-bg-software {
      --tint: 24%;
      background: radial-gradient(
        60% 55% at 28% 18%,
        color-mix(in srgb, var(--color-primary) var(--tint), transparent),
        transparent 75%
      );
    }
    /* The orange sinks into the dark navy, so it needs a harder mix there */
    .home-bg-outdoors {
      --tint: 20%;
      background: radial-gradient(
        60% 55% at 72% 18%,
        color-mix(in srgb, var(--color-accent) var(--tint), transparent),
        transparent 75%
      );
    }
    .dark .home-bg-outdoors {
      --tint: 38%;
    }
    html[data-profile='software'] .home-bg-software,
    html[data-profile='outdoors'] .home-bg-outdoors {
      opacity: 1;
    }

    [data-col] {
      transition:
        opacity 0.4s ease,
        transform 0.4s ease;
    }
    html[data-profile='software'] [data-col='outdoors'],
    html[data-profile='outdoors'] [data-col='software'] {
      opacity: 0.4;
      transform: scale(0.98);
    }
  }
</style>
