---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import HomeContent from '../components/HomeContent'
import BlogPostCard from '../components/BlogPostCard.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ProjectSpotlight from '../components/ProjectSpotlight.astro'
import StatusBadge from '../components/StatusBadge.astro'
import InterestCta from '../components/InterestCta.astro'
import SocialLinks from '../components/SocialLinks.astro'
import VariantSwitcher from '../components/proto/VariantSwitcher.astro'
import { featuredProjects } from '../data/projects'
import softwareHeadshot from '../assets/software-headshot.webp'

const tripReports = (
  await getCollection('blog', ({ data }) => data.published && data.tripReport)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<Layout>
  <VariantSwitcher
    labels={{
      a: 'Full hero + stacked sections',
      b: 'Split columns below hero',
      c: 'Content-first',
    }}
  />

  {/* ============ Variant A — full hero, then stacked sections ============ */}
  <div data-proto="a">
    <div class="flex min-h-[calc(100vh-57px)] items-center justify-center">
      <HomeContent client:load />
    </div>

    <div class="mx-auto flex w-full max-w-4xl flex-col gap-14 px-4 py-16">
      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold md:text-3xl">Building</h2>
          <a href="/projects" class="text-sm text-primary hover:underline">
            All projects →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold md:text-3xl">Recent trip reports</h2>
          <a href="/blog" class="text-sm text-primary hover:underline">
            All posts →
          </a>
        </div>
        <div class="flex flex-col gap-2">
          {
            tripReports.map((post) => (
              <BlogPostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                heroImage={post.data.heroImage}
                heroImageAlt={post.data.heroImageAlt}
              />
            ))
          }
        </div>
      </section>
    </div>
  </div>

  {/* ============ Variant B — compact hero, split columns mirror the identity split ============ */}
  <div data-proto="b">
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-10 px-4 py-10 md:py-14">
      <header class="flex flex-col items-center gap-4 text-center">
        <img
          src={softwareHeadshot.src}
          alt="Kellen Busby"
          width={112}
          height={112}
          class="w-24 rounded-full shadow-lg md:w-28"
        />
        <div class="flex flex-col gap-1">
          <h1 class="text-4xl font-extrabold md:text-5xl">Kellen Busby</h1>
          <p class="text-muted">
            Full stack software engineer · skier, climber, mountain biker
          </p>
        </div>
        <SocialLinks />
      </header>

      <div class="grid gap-10 md:grid-cols-2 md:gap-8">
        <section class="flex flex-col gap-4">
          <div class="flex items-baseline justify-between border-b border-border pb-2">
            <a href="/software" class="text-xl font-bold hover:text-primary transition-colors">
              Software
            </a>
            <a href="/projects" class="text-sm text-primary hover:underline">
              All projects →
            </a>
          </div>
          <div class="flex flex-col gap-4">
            {featuredProjects.map((p) => <ProjectCard project={p} />)}
          </div>
        </section>

        <section class="flex flex-col gap-4">
          <div class="flex items-baseline justify-between border-b border-border pb-2">
            <a href="/life" class="text-xl font-bold hover:text-primary transition-colors">
              Life
            </a>
            <a href="/blog" class="text-sm text-primary hover:underline">
              All posts →
            </a>
          </div>
          <div class="flex flex-col gap-4">
            {
              tripReports.map((post) => (
                <a href={`/blog/${post.id}`} class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card hover:shadow-lg transition-shadow">
                  {post.data.heroImage && (
                    <div class="h-36 overflow-hidden border-b border-border">
                      <Image
                        src={post.data.heroImage}
                        alt={post.data.heroImageAlt || ''}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        widths={[400, 600]}
                      />
                    </div>
                  )}
                  <div class="flex flex-col gap-1 p-4">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="text-xs text-muted"
                    >
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                    <h3 class="font-bold group-hover:text-primary transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="line-clamp-2 text-sm text-muted">
                      {post.data.description}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  {/* ============ Variant C — content-first, spotlight rows ============ */}
  <div data-proto="c">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-14 px-4 py-10 md:py-14">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
          <img
            src={softwareHeadshot.src}
            alt="Kellen Busby"
            width={64}
            height={64}
            class="w-16 rounded-full shadow-lg"
          />
          <div class="flex flex-col">
            <h1 class="text-3xl font-extrabold md:text-4xl">Kellen Busby</h1>
            <p class="text-sm text-muted">
              I build web apps. Then I go
              <a href="/life" class="text-primary hover:underline">outside</a>.
            </p>
          </div>
        </div>
        <SocialLinks />
      </header>

      <section class="flex flex-col gap-8">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold md:text-3xl">What I'm building</h2>
          <a href="/projects" class="text-sm text-primary hover:underline">
            All projects →
          </a>
        </div>
        <div class="flex flex-col gap-12">
          {
            featuredProjects.map((p, i) =>
              p.image ? (
                <ProjectSpotlight project={p} reverse={i % 2 === 1} />
              ) : (
                <div class="flex flex-col gap-2 rounded-lg border border-dashed border-border p-5">
                  <div class="flex items-center gap-3">
                    <h3 class="text-xl font-bold">{p.name}</h3>
                    <StatusBadge status={p.status} label={p.statusLabel} />
                  </div>
                  <p class="max-w-prose text-sm text-muted">{p.oneLiner}</p>
                  {p.cta && (
                    <InterestCta slug={p.slug} name={p.name} class="mt-1" />
                  )}
                </div>
              ),
            )
          }
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold md:text-3xl">Recently, outside</h2>
          <a href="/blog" class="text-sm text-primary hover:underline">
            All posts →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {
            tripReports.map((post) => (
              <a href={`/blog/${post.id}`} class="group flex flex-col gap-2">
                {post.data.heroImage && (
                  <div class="h-40 overflow-hidden rounded-lg border border-border">
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt || ''}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      widths={[400, 600]}
                    />
                  </div>
                )}
                <div class="flex flex-col gap-0.5">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-muted"
                  >
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  <h3 class="font-bold leading-snug group-hover:text-primary transition-colors">
                    {post.data.title}
                  </h3>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
