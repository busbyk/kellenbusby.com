---
import Layout from '../layouts/Layout.astro'
import PageLayout from '../components/PageLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ProjectSpotlight from '../components/ProjectSpotlight.astro'
import StatusBadge from '../components/StatusBadge.astro'
import InterestCta from '../components/InterestCta.astro'
import ProjectIndexRow from '../components/ProjectIndexRow.astro'
import VariantSwitcher from '../components/proto/VariantSwitcher.astro'
import {
  projects,
  liveProjects,
  inProgressProjects,
  featuredProjects,
} from '../data/projects'

const spotlit = featuredProjects
const liveRest = liveProjects.filter((p) => !p.featured)
const inProgressRest = inProgressProjects.filter((p) => !p.featured)
---

<Layout title="Kellen Busby's Indie Projects">
  <VariantSwitcher
    labels={{
      a: 'Spotlight + status sections',
      b: 'Card grid',
      c: 'Editorial index',
    }}
  />

  {/* ============ Variant A — featured spotlights, then status sections ============ */}
  <div data-proto="a">
    <PageLayout heading="Indie Projects">
      <div class="flex flex-col gap-1">
        <p>Things I've built and things I'm building.</p>
        <p>
          For client work, check out my
          <a
            href="https://www.contra.com/kellenbusby/?utm_source=kellenbusby.com"
            class="text-primary hover:underline">Contra portfolio</a
          >.
        </p>
      </div>

      <div class="flex flex-col gap-12 py-4">
        {spotlit.map((p, i) => <ProjectSpotlight project={p} reverse={i % 2 === 1} />)}
      </div>

      {
        liveRest.length > 0 && (
          <section class="flex flex-col gap-4">
            <h2 class="text-2xl font-bold">Live</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              {liveRest.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          </section>
        )
      }

      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold">In the works</h2>
        <div class="flex flex-col divide-y divide-border rounded-lg border border-border bg-card">
          {
            inProgressRest.map((p) => (
              <div class="flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center gap-2.5">
                    <h3 class="text-lg font-bold">{p.name}</h3>
                    <StatusBadge status={p.status} label={p.statusLabel} />
                  </div>
                  <p class="max-w-prose text-sm text-muted">{p.oneLiner}</p>
                </div>
                {p.cta && <InterestCta slug={p.slug} name={p.name} class="shrink-0" />}
              </div>
            ))
          }
        </div>
      </section>
    </PageLayout>
  </div>

  {/* ============ Variant B — uniform card grid by status ============ */}
  <div data-proto="b">
    <PageLayout heading="Indie Projects">
      <div class="flex flex-col gap-1">
        <p>Things I've built and things I'm building.</p>
        <p>
          For client work, check out my
          <a
            href="https://www.contra.com/kellenbusby/?utm_source=kellenbusby.com"
            class="text-primary hover:underline">Contra portfolio</a
          >.
        </p>
      </div>

      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold">Live</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            liveProjects.map((p) => (
              <ProjectCard
                project={p}
                class={p.featured ? 'sm:col-span-2' : ''}
              />
            ))
          }
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold">In the works</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            inProgressProjects.map((p) => (
              <ProjectCard project={p} showImage={false} class="border-dashed" />
            ))
          }
        </div>
      </section>
    </PageLayout>
  </div>

  {/* ============ Variant C — editorial index list ============ */}
  <div data-proto="c">
    <PageLayout heading="Indie Projects">
      <div class="flex flex-col gap-1">
        <p>
          {liveProjects.length} live · {inProgressProjects.length} in the works ·
          client work on
          <a
            href="https://www.contra.com/kellenbusby/?utm_source=kellenbusby.com"
            class="text-primary hover:underline">Contra</a
          >
        </p>
      </div>

      <div class="flex flex-col">
        {projects.map((p, i) => <ProjectIndexRow project={p} index={i} />)}
      </div>
    </PageLayout>
  </div>
</Layout>
