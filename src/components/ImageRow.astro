---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: [ImageMetadata, ImageMetadata] | [ImageMetadata, ImageMetadata, ImageMetadata];
  alts?: string[];
  captions?: string[];
  urls?: (string | undefined)[];
  class?: string;
}

const { images, alts = [], captions = [], urls = [], class: className } = Astro.props;

// Flex-grow proportional to aspect ratio renders every photo in the row at
// the same height (widths vary instead) so mixed orientations sit flush with
// even gaps. Each column also caps its width at what its photo can use when
// the global viewport-height cap on .blog img binds (short landscape
// viewports) — paired with justify-center the row then centers as a group
// instead of leaving photos floating in oversized columns.
const ratios = images.map((img) => img.width / img.height);
const ratioSum = ratios.reduce((a, b) => a + b, 0);
const figureStyle = (i: number) =>
  `flex: ${(ratios[i] / ratioSum).toFixed(4)} 1 0%; max-width: calc(${ratios[i].toFixed(4)} * (100vh - 57px - 2rem));`;

// Each image occupies its ratio's share of the 896px content column. The
// sizes attr must match that share: with srcset, the sizes value becomes the
// image's intrinsic CSS width, and an undersized one stops the photo from
// filling its column. Widths reach ~2x the widest single-column render so
// hi-DPI screens stay sharp.
const rowWidths = [300, 480, 720, 960];
const rowSizes = (i: number) => {
  const frac = ratios[i] / ratioSum;
  return `(max-width: 896px) ${Math.round(100 * frac)}vw, ${Math.round(896 * frac)}px`;
};
const rowQuality = 85;
---

<div class:list={["flex justify-center gap-2 md:gap-4 not-prose my-6", className]}>
  {images.map((img, i) => (
    <figure class="min-w-0" style={figureStyle(i)}>
      {urls[i] ? (
        <a href={urls[i]} target="_blank" rel="noopener noreferrer" class="group relative block">
          <Image
            src={img}
            alt={alts[i] || ''}
            class="max-w-full h-auto rounded-md shadow-lg mx-auto block"
            style="width: 100%"
            widths={rowWidths}
            sizes={rowSizes(i)}
            quality={rowQuality}
          />
          <div class="absolute top-2 right-2 -translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
            <div class="bg-white/90 dark:bg-zinc-800/90 rounded-md p-1.5 shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-700 dark:text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </div>
        </a>
      ) : (
        <Image
          src={img}
          alt={alts[i] || ''}
          class="max-w-full h-auto rounded-md shadow-lg mx-auto block"
          style="width: 100%"
          widths={rowWidths}
          sizes={rowSizes(i)}
          quality={rowQuality}
        />
      )}
      {captions[i] && (
        <figcaption class="mt-2 text-sm text-muted text-center">
          {captions[i]}
        </figcaption>
      )}
    </figure>
  ))}
</div>
