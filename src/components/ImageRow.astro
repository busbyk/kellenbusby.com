---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: [ImageMetadata, ImageMetadata] | [ImageMetadata, ImageMetadata, ImageMetadata];
  alts?: string[];
  captions?: string[];
  urls?: (string | undefined)[];
  class?: string;
}

const { images, alts = [], captions = [], urls = [], class: className } = Astro.props;
---

<div class:list={["flex gap-2 md:gap-4 not-prose my-6", className]}>
  {images.map((img, i) => (
    <figure class="flex-1 min-w-0">
      {urls[i] ? (
        <a href={urls[i]} target="_blank" rel="noopener noreferrer" class="group relative block">
          <Image
            src={img}
            alt={alts[i] || ''}
            class="w-full h-auto rounded-md shadow-lg"
            widths={[200, 400, 600]}
            sizes={`(max-width: 768px) ${Math.round(100 / images.length)}vw, ${Math.round(800 / images.length)}px`}
          />
          <div class="absolute top-2 right-2 -translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none">
            <div class="bg-white/90 dark:bg-zinc-800/90 rounded-md p-1.5 shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-700 dark:text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </div>
        </a>
      ) : (
        <Image
          src={img}
          alt={alts[i] || ''}
          class="w-full h-auto rounded-md shadow-lg"
          widths={[200, 400, 600]}
          sizes={`(max-width: 768px) ${Math.round(100 / images.length)}vw, ${Math.round(800 / images.length)}px`}
        />
      )}
      {captions[i] && (
        <figcaption class="mt-2 text-sm text-muted text-center">
          {captions[i]}
        </figcaption>
      )}
    </figure>
  ))}
</div>
