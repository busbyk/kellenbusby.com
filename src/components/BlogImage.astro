---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  url?: string;
  class?: string;
}

const { src, alt, caption, url, class: className } = Astro.props;

// Detect if the image is portrait (height > width)
const isPortrait = src.height > src.width;

const imageClasses = [
  "h-auto rounded-md shadow-xl",
  isPortrait ? "w-full max-w-9/12 sm:max-w-3/4 lg:max-w-7/12" : "w-full"
];
---

<figure class:list={[
  "my-6 not-prose",
  isPortrait && "flex flex-col items-center",
  className
]}>
  {url ? (
    <a href={url} target="_blank" rel="noopener noreferrer" class="group relative block">
      <Image
        src={src}
        alt={alt}
        class:list={imageClasses}
        widths={isPortrait ? [400, 600, 800] : [400, 800, 1200]}
        sizes={isPortrait ? "(max-width: 768px) 100vw, 400px" : "(max-width: 768px) 100vw, 800px"}
      />
      <div class="absolute top-2 right-2 -translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none">
        <div class="bg-white/90 dark:bg-zinc-800/90 rounded-md p-1.5 shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-700 dark:text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
      </div>
    </a>
  ) : (
    <Image
      src={src}
      alt={alt}
      class:list={imageClasses}
      widths={isPortrait ? [400, 600, 800] : [400, 800, 1200]}
      sizes={isPortrait ? "(max-width: 768px) 100vw, 400px" : "(max-width: 768px) 100vw, 800px"}
    />
  )}
  {caption && (
    <figcaption class="mt-2 text-sm text-muted text-center">
      {caption}
    </figcaption>
  )}
</figure>
