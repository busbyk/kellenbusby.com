---
import { Image } from 'astro:assets'
import type { Project } from '../lib/projects'
import StatusBadge from './StatusBadge.astro'
import InterestCta from './InterestCta.astro'

interface Props {
  project: Project
  index: number
}

const { project: p, index } = Astro.props
// The interest CTA is its own <a>; nesting it inside a link is invalid HTML,
// so rows with a CTA use a plain wrapper and link from the title instead.
const isLink = !p.cta
const Tag = isLink ? 'a' : 'div'
---

<Tag
  href={isLink ? `/projects/${p.slug}` : undefined}
  class="group grid gap-3 border-t border-border py-6 last:border-b md:grid-cols-[3.5rem_1fr_auto] md:items-center"
>
  <span class="hidden font-mono text-sm text-muted md:block">
    {String(index + 1).padStart(2, '0')}
  </span>
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-3">
      <h3
        class="text-2xl font-bold transition-colors group-hover:text-primary md:text-3xl"
      >
        {
          isLink ? (
            p.name
          ) : (
            <a
              href={`/projects/${p.slug}`}
              class="transition-colors hover:text-primary"
            >
              {p.name}
            </a>
          )
        }
      </h3>
      <StatusBadge status={p.status} label={p.statusLabel} />
    </div>
    <p class="max-w-prose text-sm text-muted">{p.oneLiner}</p>
    {p.note && <p class="max-w-prose text-xs italic text-muted">{p.note}</p>}
    {p.cta && <InterestCta slug={p.slug} name={p.name} compact class="mt-1" />}
  </div>
  {
    p.image && (
      <div
        class:list={[
          'hidden h-20 w-32 shrink-0 overflow-hidden rounded-md border border-border md:block',
          p.status === 'archived' && 'opacity-60',
        ]}
      >
        <Image
          src={p.image}
          alt={p.imageAlt || ''}
          class="h-full w-full object-cover object-top"
          widths={[256]}
        />
      </div>
    )
  }
</Tag>
