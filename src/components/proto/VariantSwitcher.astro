---
// Prototype-only floating A/B/C layout switcher.
// Sections tagged data-proto="a|b|c" show/hide based on html[data-variant],
// chosen via ?v= query param or the last-used value in localStorage.
// Delete this component (and the losing data-proto sections) when a winner ships.

interface Props {
  labels?: Record<string, string>
}

const { labels = {} } = Astro.props
const variants = ['a', 'b', 'c']
---

<script is:inline>
  ;(function () {
    var v = 'a'
    try {
      var param = new URLSearchParams(location.search).get('v')
      v = param || localStorage.getItem('proto-variant') || 'a'
      if (['a', 'b', 'c'].indexOf(v) === -1) v = 'a'
      localStorage.setItem('proto-variant', v)
    } catch (e) {
      /* default to a */
    }
    document.documentElement.setAttribute('data-variant', v)
  })()
</script>

<div
  class="fixed bottom-4 right-4 z-50 flex items-center gap-0.5 rounded-full border border-border bg-card p-1 shadow-lg"
>
  <span class="pl-2.5 pr-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted">
    Layout
  </span>
  {
    variants.map((v) => (
      <button
        type="button"
        data-proto-btn={v}
        title={labels[v]}
        class="size-7 rounded-full text-sm font-bold uppercase text-muted transition-colors hover:text-foreground"
      >
        {v}
      </button>
    ))
  }
</div>

<script is:inline>
  document.querySelectorAll('[data-proto-btn]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var v = btn.getAttribute('data-proto-btn')
      document.documentElement.setAttribute('data-variant', v)
      try {
        localStorage.setItem('proto-variant', v)
        var url = new URL(location.href)
        url.searchParams.set('v', v)
        history.replaceState(null, '', url)
      } catch (e) {
        /* non-critical */
      }
    })
  })
</script>

<style is:global>
  [data-proto] {
    display: none;
  }
  html[data-variant='a'] [data-proto='a'],
  html[data-variant='b'] [data-proto='b'],
  html[data-variant='c'] [data-proto='c'] {
    display: block;
  }
  html[data-variant='a'] [data-proto-btn='a'],
  html[data-variant='b'] [data-proto-btn='b'],
  html[data-variant='c'] [data-proto-btn='c'] {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }
</style>
